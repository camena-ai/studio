{
  "name": "@studio/desktop",
  "version": "0.0.0",
  "private": true,
  "description": "The Studio desktop app: Electron shell with a plain-Node main process, node-llama-cpp in a utilityProcess behind the LocalEngine seam, an encrypted SQLite cache and the bundled web build over app:// (D16, §7).",
  "type": "module",
  "main": "dist/main/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "pnpm --filter @studio/web build && pnpm build && electron .",
    "package": "scripts/package.sh --mac --dir",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "electron-updater": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "electron": "catalog:",
    "electron-builder": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "build": {
    "appId": "dev.yel.app",
    "productName": "Yel",
    "directories": {
      "output": "../release"
    },
    "files": [
      "dist/main/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "web-dist",
        "to": "web"
      }
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        "dir"
      ],
      "identity": null,
      "icon": "resources/icon.icns"
    }
  }
}
